# Copy to .env.local and fill in. Never commit real values.

# ── Supabase (required) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by cron jobs, webhooks and admin actions (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI (required for all AI features) ──────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── Server-to-server auth ──────────────────────────────────────
# Shared secret for Vercel Cron (/api/admin/transition, /api/cron/reminders)
# and the topic webhook (/api/webhooks/topics). Sent as `Authorization: Bearer …`.
# These endpoints refuse all calls while this is unset.
CRON_SECRET=generate-a-long-random-string

# ── App config ─────────────────────────────────────────────────
# Comma-separated emails auto-approved as admin on every platform at login.
SUPERADMIN_EMAILS=you@example.com
# Public base URL, shown as the webhook address in Admin → Integrations.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Governance process variant: v1 (default) or v2 (no verification phase).
GOVERNANCE_MODE=v1

# ── Local tooling only (not read by the app) ───────────────────
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_ACCESS_TOKEN=your-access-token
